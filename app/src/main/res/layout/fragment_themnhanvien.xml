<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#F9FAFB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:text="➕ Thêm nhân viên"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/edtMaNV"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Mã số nhân viên"
            android:minHeight="48dp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/edtHoTen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Họ tên"
            android:minHeight="48dp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/edtNgaySinh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ngày sinh (dd/mm/yyyy)"
            android:focusable="false"
            android:clickable="true"
            android:minHeight="48dp"
            android:layout_marginBottom="8dp" />


        <Spinner
            android:id="@+id/spinnerGioiTinh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:entries="@array/gioitinh_array"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/edtSoDT"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Số điện thoại"
            android:inputType="phone"
            android:minHeight="48dp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/edtEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Email"
            android:inputType="textEmailAddress"
            android:minHeight="48dp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/edtCCCD"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="CCCD/CMND"
            android:minHeight="48dp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/edtMatKhau"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Mật khẩu"
            android:inputType="textPassword"
            android:minHeight="48dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chọn chức vụ:"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/radioGroupChucVu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radioNhanVien"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nhân viên" />

            <RadioButton
                android:id="@+id/radioQuanLy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quản lý"
                android:layout_marginStart="28dp" />
        </RadioGroup>

        <!-- Button tạo tài khoản -->
        <Button
            android:id="@+id/btnTaoTaiKhoan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tạo tài khoản"
            android:backgroundTint="#22C55E"
            android:textColor="#FFFFFF"
            android:minHeight="48dp" />
    </LinearLayout>
</ScrollView>
