<?xml version="1.0" encoding="utf-8"?>
<!-- Nền Spinner bo góc, màu nền sáng khi bình thường, đậm hơn khi chọn -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#1EA7D8" /> <!-- khi bấm -->
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#28B6E9" />
        </shape>
    </item>

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#1EA7D8" /> <!-- khi focus -->
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#28B6E9" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="#80CBC4" /> <!-- mặc định -->
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#CCCCCC" />
        </shape>
    </item>
</selector>
